APP_NAME="TOCHKA Massage Studio"
DEBUG=True
DATABASE_URL="sqlite:///./massage_studio.db"
SECRET_KEY="change_this_to_a_secret_key"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_to_a_strong_password"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- AI ENGINES ---
GEMINI_API_KEY="your_google_ai_studio_api_key"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"

# --- TELEGRAM BOT ADAPTER ---
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_WEBHOOK_SECRET="optional_secret_token_for_webhook"

# --- WHATSAPP ADAPTER ---
# Provider options: "greenapi" | "meta" | "ultramsg"
WHATSAPP_PROVIDER="greenapi"

# Green API (QR-code based connection to salon number)
WHATSAPP_GREENAPI_INSTANCE="1101... "
WHATSAPP_GREENAPI_TOKEN="abcdef123456..."

# Meta WhatsApp Cloud API (Official Business API)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="tochka_verify_token"

# UltraMsg (Alternative)
WHATSAPP_ULTRAMSG_INSTANCE=""
WHATSAPP_ULTRAMSG_TOKEN=""
